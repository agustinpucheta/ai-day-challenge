# Local development configuration. Never commit real values.

# --- App ---
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
APP_TIMEZONE=America/Argentina/Buenos_Aires

# --- PostgreSQL (local Docker Compose) ---
POSTGRES_USER=jira_dashboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jira_dashboard
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jira_dashboard:change-me@localhost:5432/jira_dashboard?schema=public

# --- Local session ---
SESSION_SECRET=change-me

# --- Token encryption (AES-256-GCM, base64-encoded 32-byte key) ---
TOKEN_ENCRYPTION_KEY=change-me-base64-32-bytes
TOKEN_ENCRYPTION_KEY_VERSION=1

# --- Atlassian OAuth 2.0 (3LO) app, from developer.atlassian.com/console ---
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=http://localhost:3000/api/v1/jira/oauth/callback
