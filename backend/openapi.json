        ]
      }
    },
    "/api/v1/jira/issues/search": {
      "get": {
        "operationId": "JiraIssuesController_search",
        "parameters": [
          {
            "name": "q",
            "required": true,
            "in": "query",
            "description": "Free text or an issue key (e.g. MASIN-123). Trimmed, 2 to 100 characters.",
            "schema": {
              "minLength": 2,
              "maxLength": 100,
              "example": "MASIN-123",
              "type": "string"
            }
          },
          {
            "name": "pageToken",
            "required": false,
            "in": "query",
            "description": "Opaque cursor returned as nextPageToken by the previous page.",
            "schema": {
              "maxLength": 2000,
              "type": "string"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueSearchResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR: invalid or non-whitelisted input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED (no valid session) or INVALID_CREDENTIALS (login)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "EMAIL_ALREADY_REGISTERED or JIRA_NOT_CONNECTED (Jira credentials not configured)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "424": {
            "description": "JIRA_REAUTH_REQUIRED (Jira rejected the API token) or JIRA_FORBIDDEN (account lacks permission)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED (local throttle) or JIRA_RATE_LIMITED (Jira; see Retry-After)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "DATABASE_UNAVAILABLE or JIRA_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "jd.sid": []
          }
        ],
        "summary": "Search Jira issues by text or key (read-only, token-paginated)",
        "tags": [
          "jira"
        ]
      }
    },
