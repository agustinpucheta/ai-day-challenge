    }
  },
  "info": {
    "title": "Jira Dashboard API",
    "description": "Local REST API. Authentication uses a server-side session cookie. State-changing requests must send an allowed Origin header. Errors use the normalized { code, message } body.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "jd.sid": {
        "type": "apiKey",
        "in": "cookie",
        "name": "jd.sid"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320,
            "example": "ana@example.com",
            "description": "Trimmed and lowercased before storage"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 12,
            "maxLength": 256
          },
          "displayName": {
            "type": "string",
            "maxLength": 100,
            "example": "Ana"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "JiraStatusDto": {
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean",
            "description": "Placeholder until Phase 2 (Jira OAuth)",
            "example": false
          }
        },
        "required": [
          "connected"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "ana@example.com"
          },
          "displayName": {
            "type": "string",
            "nullable": true,
            "example": "Ana"
          },
          "jira": {
            "$ref": "#/components/schemas/JiraStatusDto"
          }
        },
        "required": [
          "userId",
          "email",
          "displayName",
          "jira"
        ]
      },
      "ValidationDetailDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "password"
          },
          "constraints": {
            "example": [
              "password must be longer than or equal to 12 characters"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "field",
          "constraints"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHENTICATED",
              "INVALID_CREDENTIALS",
              "VALIDATION_ERROR",
              "RATE_LIMITED",
              "FORBIDDEN",
              "FORBIDDEN_ORIGIN",
              "REGISTRATION_DISABLED",
              "EMAIL_ALREADY_REGISTERED",
              "NOT_FOUND",
              "DATABASE_UNAVAILABLE",
              "JIRA_NOT_CONNECTED",
              "JIRA_REAUTH_REQUIRED",
              "JIRA_FORBIDDEN",
              "ISSUE_NOT_FOUND_OR_INACCESSIBLE",
              "JIRA_RATE_LIMITED",
              "JIRA_UNAVAILABLE",
              "INTERNAL_ERROR"
            ],
            "example": "UNAUTHENTICATED"
          },
          "message": {
            "type": "string",
            "example": "Authentication required"
          },
          "details": {
            "description": "Present only for VALIDATION_ERROR",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationDetailDto"
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "example": "ana@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "maxLength": 256
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "PreferencesResponseDto": {
        "type": "object",
        "properties": {
          "weekStartsOn": {
            "type": "string",
            "enum": [
              "monday",
              "sunday"
            ],
            "example": "monday"
          },
          "timezone": {
            "type": "string",
            "nullable": true,
            "example": "America/Argentina/Buenos_Aires"
          },
          "showWeeklySp": {
            "type": "boolean"
          },
          "showSubtasks": {
            "type": "boolean"
          },
          "showDependencies": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "weekStartsOn",
          "timezone",
          "showWeeklySp",
          "showSubtasks",
          "showDependencies",
          "updatedAt"
        ]
      },
      "UpdatePreferencesDto": {
        "type": "object",
        "properties": {
          "weekStartsOn": {
            "type": "string",
            "enum": [
              "monday",
              "sunday"
            ]
          },
          "timezone": {
            "type": "string",
            "nullable": true,
            "description": "IANA time zone; null clears it",
            "example": "America/Argentina/Buenos_Aires"
          },
          "showWeeklySp": {
            "type": "boolean"
          },
          "showSubtasks": {
            "type": "boolean"
          },
          "showDependencies": {
            "type": "boolean"
          }
        }
      },
      "JiraConnectionStatusDto": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "api_token"
            ],
            "example": "api_token"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_configured",
              "configured"
            ],
            "example": "configured"
          },
          "siteUrl": {
            "type": "string",
            "nullable": true,
            "example": "https://acme.atlassian.net"
          }
        },
        "required": [
          "mode",
          "status",
          "siteUrl"
        ]
      },
      "JiraConnectionVerifyDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "connected"
            ],
            "example": "connected"
          },
          "siteUrl": {
            "type": "string",
            "example": "https://acme.atlassian.net"
          },
          "displayName": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When Jira was queried."
          }
        },
        "required": [
          "status",
          "siteUrl",
          "displayName",
          "checkedAt"
        ]
      },
      "IssueTypeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "10001",
            "description": "Issue type id (names are localized)."
          },
          "name": {
            "type": "string",
            "example": "Story"
          },
          "hierarchyLevel": {
            "type": "number",
            "example": 0
          },
          "isSubtask": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "hierarchyLevel",
          "isSubtask"
        ]
      },
      "IssueStatusDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "In progress"
          },
          "categoryKey": {
            "type": "string",
            "enum": [
              "new",
              "indeterminate",
              "done",
              "unknown"
            ]
          },
          "isCancelled": {
            "type": "boolean",
            "description": "The configured cancelled status (done category, not completed)."
          }
        },
        "required": [
          "name",
          "categoryKey",
          "isCancelled"
        ]
      },
      "IssueSummaryDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "MASIN-123"
          },
          "summary": {
            "type": "string"
          },
          "issueType": {
            "$ref": "#/components/schemas/IssueTypeDto"
          },
          "status": {
            "$ref": "#/components/schemas/IssueStatusDto"
          },
          "url": {
            "type": "string",
            "example": "https://acme.atlassian.net/browse/MASIN-123"
          }
        },
        "required": [
          "key",
          "summary",
          "issueType",
          "status",
          "url"
        ]
      },
      "IssueMetadataDto": {
        "type": "object",
        "properties": {
          "fetchedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When Jira was queried."
          },
          "isStale": {
            "type": "boolean",
            "example": false,
            "description": "Always false: data is read live from Jira."
          }
        },
        "required": [
          "fetchedAt",
          "isStale"
        ]
      },
      "IssueSearchResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IssueSummaryDto"
            }
          },
          "nextPageToken": {
            "type": "string",
            "nullable": true,
            "description": "Opaque cursor for the next page; null on the last page."
          },
          "metadata": {
            "$ref": "#/components/schemas/IssueMetadataDto"
          }
        },
        "required": [
          "items",
          "nextPageToken",
          "metadata"
        ]
      },
      "StoryPointsDto": {
        "type": "object",
        "properties": {
          "final": {
            "type": "number",
            "nullable": true,
            "description": "Final SP; null means no estimate."
          },
          "planned": {
            "type": "number",
            "nullable": true,
            "description": "Planned SP; null means no estimate."
          }
        },
        "required": [
          "final",
          "planned"
        ]
      },
      "DashboardIssueDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "example": "MASIN-123"
          },
          "summary": {
            "type": "string"
          },
          "issueType": {
            "$ref": "#/components/schemas/IssueTypeDto"
          },
          "status": {
            "$ref": "#/components/schemas/IssueStatusDto"
          },
          "url": {
            "type": "string"
          },
          "parentKey": {
            "type": "string",
            "nullable": true
          },
          "storyPoints": {
            "$ref": "#/components/schemas/StoryPointsDto"
          }
        },
        "required": [
          "id",
          "key",
          "summary",
          "issueType",
          "status",
          "url",
          "parentKey",
          "storyPoints"
        ]
      },
      "DashboardSubtaskDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/IssueStatusDto"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "summary",
          "status",
          "url"
        ]
      },
      "ProgressDto": {
        "type": "object",
        "properties": {
          "basis": {
            "type": "string",
            "enum": [
              "subtasks",
              "children",
              "none"
            ],
            "description": "What was counted; none = nothing applies."
          },
          "state": {
            "type": "string",
            "enum": [
              "ok",
              "none",
              "all_cancelled"
            ],
            "description": "ok = percent available; none = no data (never 0%); all_cancelled = all cancelled."
          },
          "total": {
            "type": "number",
            "description": "Denominator (cancelled excluded by default, D-024)."
          },
          "completed": {
            "type": "number"
          },
          "inProgress": {
            "type": "number"
          },
          "pending": {
            "type": "number"
          },
          "cancelled": {
            "type": "number",
            "description": "Cancelled items, always reported separately."
          },
          "unknown": {
            "type": "number",
            "description": "Items with an unrecognized status category (never completed)."
          },
          "percent": {
            "type": "number",
            "nullable": true,
            "description": "0-100, one decimal; null = no data."
          },
          "isApproximate": {
            "type": "boolean",
            "description": "True when the children list was truncated at the hard cap."
          }
        },
        "required": [
          "basis",
          "state",
          "total",
          "completed",
          "inProgress",
          "pending",
          "cancelled",
          "unknown",
          "percent",
          "isApproximate"
        ]
      },
      "DashboardChildDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "issueType": {
            "$ref": "#/components/schemas/IssueTypeDto"
          },
          "status": {
            "$ref": "#/components/schemas/IssueStatusDto"
          },
          "url": {
            "type": "string"
          },
          "storyPoints": {
            "$ref": "#/components/schemas/StoryPointsDto"
          },
          "progress": {
            "description": "Progress of the child by its own subtasks.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProgressDto"
              }
            ]
          }
        },
        "required": [
          "key",
          "summary",
          "issueType",
          "status",
          "url",
          "storyPoints",
          "progress"
        ]
      },
      "IssueDetailMetadataDto": {
        "type": "object",
        "properties": {
          "fetchedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When Jira was queried."
          },
          "isStale": {
            "type": "boolean",
            "example": false,
            "description": "Always false: data is read live from Jira."
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "fetchedAt",
          "isStale",
          "warnings"
        ]
      },
      "DashboardIssueResponseDto": {
        "type": "object",
        "properties": {
          "issue": {
            "$ref": "#/components/schemas/DashboardIssueDto"
          },
          "subtasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardSubtaskDto"
            }
          },
          "progress": {
            "$ref": "#/components/schemas/ProgressDto"
          },
          "children": {
            "description": "Direct children (epics only; absent otherwise).",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardChildDto"
            }
          },
          "metadata": {
            "$ref": "#/components/schemas/IssueDetailMetadataDto"
          }
        },
        "required": [
          "issue",
          "subtasks",
          "progress",
          "metadata"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "up"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "database",
          "checkedAt"
        ]
      }
    }
  }
}
