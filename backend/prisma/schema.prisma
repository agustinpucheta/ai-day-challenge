// Local identity, server sessions, preferences, audit and Jira OAuth connections (Phase 2).
// Tracked issues (Phase 6).
// All timestamps are stored as timestamptz (UTC); DB names are snake_case.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Compiled output is plain CommonJS .js, so generated imports must not keep ".ts".
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum WeekStartDay {
  monday
  sunday

  @@map("week_start_day")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  emailNormalized String    @unique @map("email_normalized")
  displayName     String?   @map("display_name")
  // Nullable so future external-only identities (Microsoft) can exist.
  passwordHash    String?   @map("password_hash")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(3)

  externalIdentities ExternalIdentity[]
  preferences        UserPreferences?
  auditEvents        AuditEvent[]
  jiraConnections    JiraConnection[]
  oauthStates        OAuthState[]
  trackedIssues      TrackedIssue[]

  @@map("users")
}

// Designed for the future Microsoft sign-in (Delivery 2). Never auto-link by email.
enum JiraConnectionStatus {
  active
  reauthorization_required

  @@map("jira_connection_status")
}

model ExternalIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  provider  String
  issuer    String
  subject   String
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, issuer, subject])
  @@index([userId])
  @@map("external_identities")
}

// Table owned by connect-pg-simple (express-session store). Its shape must match
// the library's expected schema; the store runs with createTableIfMissing=false.
model UserSession {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_user_sessions_expire")
  @@map("user_sessions")
}

model UserPreferences {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @unique @map("user_id") @db.Uuid
  weekStartsOn     WeekStartDay @default(monday) @map("week_starts_on")
  timezone         String?
  showWeeklySp     Boolean      @default(true) @map("show_weekly_sp")
  showSubtasks     Boolean      @default(true) @map("show_subtasks")
  showDependencies Boolean      @default(true) @map("show_dependencies")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// Never store passwords, hashes, tokens, OAuth codes, cookies or raw request bodies.
model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  connectionId   String?  @map("connection_id") @db.Uuid
  eventType      String   @map("event_type")
  targetIssueKey String?  @map("target_issue_key")
  metadata       Json?    @db.JsonB
  success        Boolean
  errorCode      String?  @map("error_code")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  connection JiraConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@map("audit_events")
}

// One row per Jira site a user authorized. Tokens are stored only as AES-256-GCM envelopes
// (see TokenCipher); never return or log them.
model JiraConnection {
  id                     String               @id @default(uuid()) @db.Uuid
  userId                 String               @map("user_id") @db.Uuid
  cloudId                String               @map("cloud_id")
  siteUrl                String               @map("site_url")
  siteName               String               @map("site_name")
  atlassianAccountId     String?              @map("atlassian_account_id")
  accessTokenCiphertext  String               @map("access_token_ciphertext")
  refreshTokenCiphertext String               @map("refresh_token_ciphertext")
  accessTokenExpiresAt   DateTime             @map("access_token_expires_at") @db.Timestamptz(3)
  grantedScopes          String[]             @map("granted_scopes")
  status                 JiraConnectionStatus @default(active)
  encryptionKeyVersion   Int                  @map("encryption_key_version")
  connectedAt            DateTime             @default(now()) @map("connected_at") @db.Timestamptz(3)
  lastUsedAt             DateTime?            @map("last_used_at") @db.Timestamptz(3)
  lastRefreshedAt        DateTime?            @map("last_refreshed_at") @db.Timestamptz(3)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditEvents AuditEvent[]

  @@unique([userId, cloudId])
  @@index([userId])
  @@map("jira_connections")
}

// Issues a user follows. Only the key is stored: Jira stays the source of truth for everything
// else. `jiraSiteUrl` (normalized origin of the configured Jira site) keeps lists from mixing
// if the site changes (D-023).
model TrackedIssue {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  issueKey     String   @map("issue_key")
  jiraSiteUrl  String   @map("jira_site_url")
  displayOrder Int      @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jiraSiteUrl, issueKey])
  @@index([userId, displayOrder])
  @@map("tracked_issues")
}

// Short-lived, single-use OAuth state bound to the session. Only the SHA-256 hash is stored.
model OAuthState {
  id         String    @id @default(uuid()) @db.Uuid
  stateHash  String    @unique @map("state_hash")
  userId     String    @map("user_id") @db.Uuid
  sessionId  String    @map("session_id")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_states")
}
